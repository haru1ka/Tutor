<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F8"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="60dp">

        <!-- Верхняя панель -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/btnBackStudent3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:drawableStart="@drawable/ic_arrow_back"
                android:text="Назад"
                android:textColor="@color/blue2"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Шаг 3 из 3"
                android:textColor="@color/blue2"
                android:textSize="14sp" />

        </RelativeLayout>

        <!-- Полностью заполненный прогресс -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="30dp">

            <ProgressBar
                android:layout_width="266dp"
                android:layout_height="10dp"
                android:layout_gravity="center"
                android:max="100"
                android:progress="100"
                android:progressDrawable="@drawable/questionnaire_progress"
                style="?android:attr/progressBarStyleHorizontal" />

        </FrameLayout>

        <!-- Заголовок -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:gravity="center"
            android:text="Удобный график"
            android:textColor="@color/dark_blue"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Время -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:text="Сколько времени вы готовы уделять?"
            android:textColor="@color/dark_blue"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/studentTimeOneTwo"
                style="@style/QuestionOption"
                android:text="1–2 часа" />

            <TextView
                android:id="@+id/studentTimeThreeFour"
                style="@style/QuestionOption"
                android:text="3–4 часа" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/studentTimeFivePlus"
                style="@style/QuestionOption"
                android:text="5+ часов" />

        </LinearLayout>

        <!-- Условия менторства -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="В какое время вам удобно?"
            android:textColor="@color/dark_blue"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/studentTimeMorning"
                style="@style/QuestionOption"
                android:text="Утро" />

            <TextView
                android:id="@+id/studentTimeDay"
                style="@style/QuestionOption"
                android:text="День"
                android:gravity="center"
                android:textAlignment="center"
                android:maxLines="2"
                android:paddingStart="5dp"
                android:paddingEnd="5dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/studentTimeEvening"
                style="@style/QuestionOption"
                android:text="Вечер" />

        </LinearLayout>

        <!-- Срок менторства -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="На какой срок ищем наставника?"
            android:textColor="@color/dark_blue"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/studentDurationOneMonth"
                style="@style/QuestionOption"
                android:text="1 месяц" />

            <TextView
                android:id="@+id/studentDurationThreeMonths"
                style="@style/QuestionOption"
                android:text="3 месяца" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/studentDurationSixMonths"
                style="@style/QuestionOption"
                android:text="6 месяцев" />

        </LinearLayout>

        <!-- Завершить -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinishStudentQuestionnaire"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="35dp"
            android:layout_marginBottom="20dp"
            android:text="ЗАВЕРШИТЬ"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:gravity="center"
            android:textAlignment="center"
            app:backgroundTint="@color/orange"
            app:cornerRadius="9dp" />

    </LinearLayout>

</ScrollView>
