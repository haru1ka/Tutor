<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="60dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBackStudent2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹  Назад"
                android:textColor="@color/dark_blue"
                android:textSize="16sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Шаг 2 из 3"
                android:textColor="@color/grey"
                android:textSize="14sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="24dp">

            <ProgressBar
                android:layout_width="266dp"
                android:layout_height="10dp"
                android:layout_gravity="center"
                android:max="100"
                android:progress="66"
                android:progressDrawable="@drawable/questionnaire_progress"
                style="?android:attr/progressBarStyleHorizontal" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Ваши навыки и формат"
            android:textColor="@color/dark_blue"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="20dp"
            android:text="Текущие навыки"
            android:textColor="@color/dark_blue"
            android:textSize="18sp"
            android:textStyle="bold" />


        <!-- Навыки: ряд 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/studentSkillPython"
                style="@style/QuestionOption"
                android:text="Python" />

            <TextView
                android:id="@+id/studentSkillSQL"
                style="@style/QuestionOption"
                android:text="SQL" />
        </LinearLayout>

        <!-- Навыки: ряд 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/studentSkillFigma"
                style="@style/QuestionOption"
                android:text="Figma" />

            <TextView
                android:id="@+id/studentSkillExcel"
                style="@style/QuestionOption"
                android:text="Excel" />
        </LinearLayout>

        <!-- Навыки: ряд 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/studentSkillCopywriting"
                style="@style/QuestionOption"
                android:text="Копирайтинг" />

            <TextView
                android:id="@+id/studentSkillOther"
                style="@style/QuestionOption"
                android:text="Другое" />

        </LinearLayout>

        <!-- Навыки: ряд 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/studentSkillProjectManagement"
                style="@style/QuestionOption"
                android:maxLines="2"
                android:text="Управление проектами" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Желаемые навыки"
            android:textColor="@color/dark_blue"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etStudentDesiredSkills"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/edit_text_background"
            android:gravity="top|start"
            android:hint="Какие навыки хотите прокачать?"
            android:padding="14dp"
            android:textColor="@color/dark_blue"
            android:textSize="14sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Как вам удобнее общаться?"
            android:textColor="@color/dark_blue"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Можно выбрать несколько"
            android:textColor="@color/grey"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/studentCommunicationChat"
                style="@style/QuestionOption"
                android:text="Текстовый чат"/>

            <TextView
                android:id="@+id/studentCommunicationVideo"
                style="@style/QuestionOption"
                android:text="Онлайн-видео"/>


        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/studentCommunicationOffline"
                style="@style/QuestionOption"
                android:text="Офлайн-встреча"/>

        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStudentNext2"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="30dp"
            android:text="ДАЛЕЕ"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/orange"
            app:cornerRadius="14dp" />

    </LinearLayout>
</ScrollView>
